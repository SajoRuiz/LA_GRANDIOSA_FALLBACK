# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Application
APP_BASE_URL=http://localhost:3000
BUSINESS_TIME_ZONE=America/Puerto_Rico
NOTIFICATION_BATCH_SIZE=25

# Approved La Grandiosa addresses
INTERNAL_PROCESSING_EMAIL=processing@lagrandiosapr.com
SALES_REPLY_TO_EMAIL=ventas@lagrandiosapr.com
TRANSACTIONAL_FROM_EMAIL=orders@lagrandiosapr.com

# Resend — email delivery
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Twilio — transactional SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
TWILIO_STATUS_CALLBACK_URL=http://localhost:3000/api/webhooks/twilio/status

# Automation endpoint protection
# Use a long random value. Vercel Cron sends it as Authorization: Bearer <value>.
CRON_SECRET=
