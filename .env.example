# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Application
APP_BASE_URL=http://localhost:3000

# Approved La Grandiosa addresses
INTERNAL_PROCESSING_EMAIL=processing@yourdomain.com
SALES_REPLY_TO_EMAIL=ventas@yourdomain.com
TRANSACTIONAL_FROM_EMAIL=orders@yourdomain.com

# Production overrides can be added in your local .env file.
# Example:
# APP_BASE_URL=https://www.yourdomain.com
